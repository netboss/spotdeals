{# Dedicated full-page presentation; Drupal continues to own comment forms and links. #}
{% set classes = ['node', 'node--type-conversation', 'sd-conversation-detail'] %}
{{ attach_library('spotdeals_minimal/conversation_detail') }}
<article{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if label and view_mode != 'full' %}
    <h2{{ title_attributes }}><a href="{{ url }}">{{ label }}</a></h2>
  {% endif %}
  {{ title_suffix }}

  <header class="sd-conversation-detail__header">
    <div class="sd-conversation-detail__eyebrow">{{ 'Community conversation'|t }}</div>
    <div class="sd-conversation-detail__byline">
      <span class="sd-conversation-detail__author">{{ author_name }}</span>
      {% if date %}<span class="sd-conversation-detail__date">{{ date }}</span>{% endif %}
    </div>
    {% if metadata %}
      <div class="sd-conversation-detail__relationships">{{ metadata }}</div>
    {% endif %}
  </header>

  {% if content.field_conversation_body %}
    <div class="sd-conversation-detail__body">{{ content.field_conversation_body }}</div>
  {% endif %}
  {% if content.field_address %}
    <div class="sd-conversation-detail__location">{{ content.field_address }}</div>
  {% endif %}

  {# Keep Drupal's existing actions and comment field, including reply permissions. #}
  <div class="sd-conversation-detail__extra">
    {{ content|without('field_conversation_body', 'field_address', 'field_conversation_replies') }}
  </div>
  {% if content.field_conversation_replies %}
    <section class="sd-conversation-detail__discussion" aria-label="{{ 'Replies'|t }}">
      <h2>{{ 'Join the conversation'|t }}</h2>
      {{ content.field_conversation_replies }}
    </section>
  {% endif %}
</article>
