{#
/**
 * @file
 * Theme implementation for SpotDeals taxonomy term landing pages.
 */
#}
{% set landing = spotdeals_taxonomy_landing|default({}) %}
{% set has_landing = landing.title is defined %}

{% if has_landing %}
  <section{{ attributes.addClass('spotdeals-taxonomy-landing', 'spotdeals-taxonomy-landing--' ~ landing.vocabulary|clean_class) }}>
    <header class="spotdeals-taxonomy-landing__hero">
      {% if landing.vocabulary == 'tags' %}
        <div class="spotdeals-taxonomy-landing__topic-grid{% if not landing.tag_local_topics.links %} spotdeals-taxonomy-landing__topic-grid--single{% endif %}">
          <div class="spotdeals-taxonomy-landing__topic-primary">
            {% if landing.eyebrow %}
              <div class="spotdeals-taxonomy-landing__eyebrow">{{ landing.eyebrow }}</div>
            {% endif %}

            {{ title_prefix }}
            <h2 class="spotdeals-taxonomy-landing__hero-title">{{ landing.title }}</h2>
            {{ title_suffix }}

            {% if landing.intro %}
              <div class="spotdeals-taxonomy-landing__intro">{{ landing.intro }}</div>
            {% endif %}

            {% if landing.tag_related_content %}
              <div class="spotdeals-taxonomy-landing__topic-count" aria-label="{{ 'Content using this topic'|t }}">
                <div class="spotdeals-taxonomy-landing__topic-count-icon" aria-hidden="true">{{ landing.tag_related_content.icon }}</div>
                <div>
                  <div class="spotdeals-taxonomy-landing__topic-count-value">{{ landing.tag_related_content.count }}</div>
                  <div class="spotdeals-taxonomy-landing__topic-count-label">{{ landing.tag_related_content.label }}</div>
                </div>
              </div>
            {% endif %}
          </div>

          {% if landing.tag_local_topics.links %}
            <aside class="spotdeals-taxonomy-landing__more-topics">
              <div class="spotdeals-taxonomy-landing__more-topics-desktop" aria-labelledby="spotdeals-more-local-topics-desktop">
                <h3 id="spotdeals-more-local-topics-desktop" class="spotdeals-taxonomy-landing__more-topics-heading">{{ 'More in @location'|t({'@location': landing.tag_local_topics.location}) }}</h3>
                <div class="spotdeals-taxonomy-landing__more-topic-links">
                  {% for link in landing.tag_local_topics.links %}
                    <a href="{{ link.url }}">{{ link.title }}</a>
                  {% endfor %}
                </div>
              </div>

              <details class="spotdeals-taxonomy-landing__more-topics-accordion spotdeals-taxonomy-landing__more-topics-accordion--mobile">
                <summary id="spotdeals-more-local-topics-mobile" class="spotdeals-taxonomy-landing__more-topics-heading">{{ 'More in @location'|t({'@location': landing.tag_local_topics.location}) }}</summary>
                <div class="spotdeals-taxonomy-landing__more-topic-links">
                  {% for link in landing.tag_local_topics.links %}
                    <a href="{{ link.url }}">{{ link.title }}</a>
                  {% endfor %}
                </div>
              </details>
            </aside>
          {% endif %}
        </div>
      {% else %}
        {% if landing.eyebrow %}
          <div class="spotdeals-taxonomy-landing__eyebrow">{{ landing.eyebrow }}</div>
        {% endif %}

        {{ title_prefix }}
        <h2 class="spotdeals-taxonomy-landing__hero-title">{{ landing.title }}</h2>
        {{ title_suffix }}

        {% if landing.intro %}
          <div class="spotdeals-taxonomy-landing__intro">{{ landing.intro }}</div>
        {% endif %}
      {% endif %}

      {% if landing.stats %}
        <div class="spotdeals-seo-summary spotdeals-taxonomy-landing__summary" aria-label="{{ 'Page summary'|t }}">
          {% for stat in landing.stats %}
            <div class="spotdeals-seo-summary__card">
              {% if stat.icon %}
                <div class="spotdeals-seo-summary__icon" aria-hidden="true">{{ stat.icon }}</div>
              {% endif %}
              <div class="spotdeals-seo-summary__value">{{ stat.value }}</div>
              <div class="spotdeals-seo-summary__label">{{ stat.label }}</div>
              {% if stat.description %}
                <div class="spotdeals-seo-summary__description">{{ stat.description }}</div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </header>

    {{ content|without('description') }}

    {% if landing.related_links %}
      <section class="spotdeals-seo-related spotdeals-taxonomy-landing__related" aria-labelledby="spotdeals-taxonomy-related-title">
        <h2 id="spotdeals-taxonomy-related-title" class="spotdeals-seo-section-title">{{ 'Related deal pages'|t }}</h2>
        <div class="spotdeals-seo-related__links">
          {% for link in landing.related_links %}
            <a class="spotdeals-seo-related__link" href="{{ link.url }}">
              <span class="spotdeals-seo-related__icon" aria-hidden="true">🏷</span>
              <span>
                {{ link.title }}
                {% if link.subtitle %}
                  <small>{{ link.subtitle }}</small>
                {% endif %}
              </span>
            </a>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if landing.faq %}
      <section class="spotdeals-taxonomy-faq" aria-labelledby="spotdeals-taxonomy-faq-title">
        <h2 id="spotdeals-taxonomy-faq-title" class="spotdeals-seo-section-title">{{ 'Frequently asked questions'|t }}</h2>

        <div class="spotdeals-taxonomy-faq__items spotdeals-taxonomy-faq__items--desktop">
          {% for item in landing.faq %}
            <details class="spotdeals-taxonomy-faq__item">
              <summary>{{ item.question }}</summary>
              <p>{{ item.answer }}</p>
            </details>
          {% endfor %}
        </div>

        <details class="spotdeals-taxonomy-faq__accordion spotdeals-taxonomy-faq__accordion--mobile">
          <summary class="spotdeals-taxonomy-faq__accordion-summary">{{ 'Frequently asked questions'|t }}</summary>
          <div class="spotdeals-taxonomy-faq__items">
            {% for item in landing.faq %}
              <details class="spotdeals-taxonomy-faq__item">
                <summary>{{ item.question }}</summary>
                <p>{{ item.answer }}</p>
              </details>
            {% endfor %}
          </div>
        </details>
      </section>
    {% endif %}

    {% if landing.show_deal_cta|default(true) %}
    <section class="spotdeals-seo-cta spotdeals-taxonomy-landing__cta" aria-label="{{ 'Search more deals'|t }}">
      <div>
        <h2>{{ 'Want to search another way?'|t }}</h2>
        <p>{{ 'Browse all current deals by keyword, category, city, or nearby location.'|t }}</p>
      </div>
      <a class="spotdeals-seo-cta__button" href="{{ landing.browse_url }}">{{ 'Browse all deals'|t }}</a>
    </section>
    {% endif %}
  </section>
{% else %}
  <article{{ attributes }}>
    {{ title_prefix }}
    {% if name and not page %}
      <h2>{{ name }}</h2>
    {% endif %}
    {{ title_suffix }}
    {{ content }}
  </article>
{% endif %}
