{#
/**
 * @file
 * SpotDeals Minimal page layout.
 *
 * Keeps Olivero's original header markup/data selectors so the sticky/header
 * behaviors continue to work, while preserving the SpotDeals three-column main
 * content shell used by the Deals redesign work.
 */
#}
{% set has_sidebar_left = page.sidebar_left ? true : false %}
{% set has_sidebar_right = page.sidebar ? true : false %}
{% set main_classes = [
  'spotdeals-page-main',
  has_sidebar_left ? 'spotdeals-page-main--has-left-sidebar',
  has_sidebar_right ? 'spotdeals-page-main--has-right-sidebar',
] %}

<div id="page-wrapper" class="page-wrapper">
  <div id="page">

    {% if page.header or page.primary_menu or page.secondary_menu %}
      <header id="header" class="site-header" data-drupal-selector="site-header">

        {# Gets fixed by Olivero JavaScript at wide widths. #}
        <div class="site-header__fixable" data-drupal-selector="site-header-fixable">
          <div class="site-header__initial">
            <button class="sticky-header-toggle" data-drupal-selector="sticky-header-toggle" role="switch" aria-controls="site-header__inner" aria-label="{{ 'Sticky header'|t }}" aria-checked="false">
              <span class="sticky-header-toggle__icon">
                <span></span>
                <span></span>
                <span></span>
              </span>
            </button>
          </div>

          {# Needs to extend full width so box shadow will also extend. #}
          <div id="site-header__inner" class="site-header__inner" data-drupal-selector="site-header-inner">
            <div class="container site-header__inner__container">

              {{ page.header }}

              {% if page.primary_menu or page.secondary_menu %}
                <div class="mobile-buttons" data-drupal-selector="mobile-buttons">
                  <button class="mobile-nav-button" data-drupal-selector="mobile-nav-button" aria-label="{{ 'Main Menu'|t }}" aria-controls="header-nav" aria-expanded="false">
                    <span class="mobile-nav-button__label">{{ 'Menu'|t }}</span>
                    <span class="mobile-nav-button__icon"></span>
                  </button>
                </div>

                <div id="header-nav" class="header-nav" data-drupal-selector="header-nav">
                  {{ page.primary_menu }}
                  {{ page.secondary_menu }}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </header>
    {% endif %}

    <div id="main-wrapper" class="layout-main-wrapper layout-container">
      <div id="main" class="layout-main">
        <div class="main-content">
          <a id="main-content" tabindex="-1"></a>
          <div class="main-content__container container">

            {{ page.hero }}

            {% if page.highlighted %}
              <div class="highlighted spotdeals-highlighted">
                {{ page.highlighted }}
              </div>
            {% endif %}

            {% if page.breadcrumb %}
              <div class="breadcrumb spotdeals-breadcrumb">
                {{ page.breadcrumb }}
              </div>
            {% endif %}

            <div{{ attributes.addClass(main_classes) }}>
              {% if page.sidebar_left %}
                <aside class="spotdeals-sidebar-left" role="complementary" aria-label="{{ 'Search and filters'|t }}">
                  {{ page.sidebar_left }}
                </aside>
              {% endif %}

              <main class="spotdeals-main-content">
                {% if is_front %}
                  <section class="spotdeals-home-feed" aria-label="{{ 'Tonight Near You'|t }}">
                    <div class="spotdeals-home-feed__hero">
                      <div class="spotdeals-home-feed__eyebrow">{{ 'Tonight Near You'|t }}</div>
                      <h2 class="spotdeals-home-feed__title">{{ 'Need help deciding where to go?'|t }}</h2>
                      <p class="spotdeals-home-feed__text">
                        {{ 'Discover nearby businesses, deals and local favorites without endlessly scrolling.'|t }}
                      </p>
                    </div>

                    <div class="spotdeals-home-feed__chips" aria-label="{{ 'Quick mood picks'|t }}">
                      <button class="spotdeals-home-feed__chip" type="button">{{ '🍹 Happy Hour'|t }}</button>
                      <button class="spotdeals-home-feed__chip" type="button">{{ '🌮 Quick Bite'|t }}</button>
                      <button class="spotdeals-home-feed__chip" type="button">{{ '🍕 Comfort Food'|t }}</button>
                      <button class="spotdeals-home-feed__chip" type="button">{{ '☕ Coffee Break'|t }}</button>
                      <button class="spotdeals-home-feed__chip" type="button">{{ '🍺 Drinks Tonight'|t }}</button>
                      <button class="spotdeals-home-feed__chip" type="button">{{ '🎲 Surprise Me'|t }}</button>
                    </div>

                    <div class="spotdeals-home-feed__cards">
                      <article class="spotdeals-home-feed__card spotdeals-home-feed__card--featured">
                        <div class="spotdeals-home-feed__card-tag">{{ 'Trending nearby tonight'|t }}</div>
                        <h3>{{ 'Popular happy hour spots nearby'|t }}</h3>
                        <p>{{ 'Explore nearby deals, offers and local favorites happening right now.'|t }}</p>
                        <button class="spotdeals-home-feed__cta" type="button">{{ 'Help Me Choose'|t }}</button>
                      </article>

                      <article class="spotdeals-home-feed__card">
                        <div class="spotdeals-home-feed__mini-tag">{{ 'Open now'|t }}</div>
                        <h4>{{ 'Tacos + Margaritas'|t }}</h4>
                        <p>{{ 'Popular nearby Mexican spots with active deals.'|t }}</p>
                      </article>

                      <article class="spotdeals-home-feed__card">
                        <div class="spotdeals-home-feed__mini-tag">{{ 'Trending'|t }}</div>
                        <h4>{{ 'Late Night Bites'|t }}</h4>
                        <p>{{ 'Fast nearby recommendations for tonight.'|t }}</p>
                      </article>

                      <article class="spotdeals-home-feed__card">
                        <div class="spotdeals-home-feed__mini-tag">{{ 'Nearby'|t }}</div>
                        <h4>{{ 'Coffee + Breakfast'|t }}</h4>
                        <p>{{ 'Quick local picks for a morning or afternoon stop.'|t }}</p>
                      </article>
                    </div>
                  </section>
                {% endif %}

                {{ page.content_above }}
                {{ page.content }}

                {% if spotdeals_not_found_popular_searches or spotdeals_not_found_trending or spotdeals_not_found_promoted_slot %}
                  <section class="sd-profile--private" aria-label="{{ 'Continue exploring SpotDeals'|t }}">
                    <nav class="sd-profile__private-actions" aria-label="{{ 'Page not found actions'|t }}">
                      <a class="sd-profile__private-action sd-profile__private-action--back" href="#" onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '/'; } return false;">← {{ 'Go back'|t }}</a>
                      <a class="sd-profile__private-action sd-profile__private-action--primary" href="/deals">{{ 'Find deals'|t }} →</a>
                    </nav>

                    {% if spotdeals_not_found_popular_searches or spotdeals_not_found_trending %}
                      <section class="sd-profile__private-discovery" aria-label="{{ 'Explore SpotDeals'|t }}">
                        <div class="sd-profile__private-discovery-head">
                          <span>{{ 'Keep exploring'|t }}</span>
                          <h2>{{ 'Discover something nearby'|t }}</h2>
                        </div>
                        <div class="sd-profile__private-discovery-grid">
                          {% if spotdeals_not_found_popular_searches %}
                            <div class="sd-profile__private-discovery-card sd-profile__private-discovery-card--searches">
                              {{ spotdeals_not_found_popular_searches }}
                            </div>
                          {% endif %}
                          {% if spotdeals_not_found_trending %}
                            <div class="sd-profile__private-discovery-card sd-profile__private-discovery-card--trending">
                              {{ spotdeals_not_found_trending }}
                            </div>
                          {% endif %}
                        </div>
                      </section>
                    {% endif %}

                    {% if spotdeals_not_found_promoted_slot %}
                      <div class="sd-profile__private-sponsored">
                        {{ spotdeals_not_found_promoted_slot }}
                      </div>
                    {% endif %}
                  </section>
                {% endif %}

                {{ page.content_below }}
              </main>

              {% if page.sidebar %}
                <div class="layout-sidebar-second spotdeals-sidebar-right" role="complementary" aria-label="{{ 'Related content'|t }}">
                  {{ page.sidebar }}
                </div>
              {% endif %}
            </div>
          </div>
        </div>

        <div class="social-bar">
          {{ page.social }}
        </div>
      </div>
    </div>

    {% if page.footer_top or page.footer_bottom %}
      <footer class="site-footer">
        <div class="site-footer__inner container">
          {{ page.footer_top }}
          {{ page.footer_bottom }}
        </div>
      </footer>
    {% endif %}

    <div class="overlay" data-drupal-selector="overlay"></div>

  </div>
</div>
