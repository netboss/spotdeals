{# Full conversation: reuse the AJAX discussion panel, never the core comment field. #}
<article{{ attributes.addClass('sd-conversation-detail') }}>
  <header class="sd-conversation-detail__header">
    <div class="sd-conversation-detail__eyebrow">{{ 'Community conversation'|t }}</div>
    <div class="sd-conversation-detail__byline">
      <span class="sd-conversation-detail__author">{{ author_name }}</span>
      {% if date %}<span>{{ date }}</span>{% endif %}
    </div>
  </header>
  {% if content.field_address is defined %}
    <div class="sd-conversation-detail__location">{{ content.field_address }}</div>
  {% endif %}
  <section class="sd-conversation-detail__discussion" aria-label="{{ 'Conversation and replies'|t }}">
    <div id="{{ spotdeals_conversation_target }}" class="sd-conversation-detail__inline">
      {{ spotdeals_conversation_discussion }}
    </div>
  </section>
</article>
