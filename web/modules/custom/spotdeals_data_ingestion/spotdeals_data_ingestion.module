<?php

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\node\NodeInterface;
use Drupal\taxonomy\TermInterface;

/**
 * Implements hook_pathauto_alias_alter().
 *
 * New venue aliases use a clean URL that removes one trailing copy of the city
 * from the title slug.
 *
 * Existing aliases deliberately retain whichever URL style they already use.
 * This prevents routine update/bulk-update operations from migrating previously
 * indexed venue URLs while allowing newly created venues and newly created
 * language aliases to use the clean URL format.
 *
 * Example:
 *
 *   Stored venue title:
 *   Sound Coffee - Bridgeport
 *
 *   Pathauto candidate:
 *   /venue/bridgeport/sound-coffee-bridgeport
 *
 *   New venue alias:
 *   /venue/bridgeport/sound-coffee
 *
 * Existing old-style aliases such as:
 *
 *   /venue/orlando/stk-orlando-orlando
 *
 * remain unchanged during update and bulkupdate operations.
 */
function spotdeals_data_ingestion_pathauto_alias_alter(
  &$alias,
  array &$context,
): void {
  $operation = (string) ($context['op'] ?? '');

  if (!in_array($operation, ['insert', 'update', 'bulkupdate'], TRUE)) {
    return;
  }

  $node = $context['data']['node'] ?? NULL;
  if (!$node instanceof NodeInterface || $node->bundle() !== 'venue') {
    return;
  }

  if (!is_string($alias) || $alias === '') {
    return;
  }

  $clean_alias = _spotdeals_data_ingestion_clean_venue_alias_candidate($alias);

  if ($clean_alias === NULL) {
    return;
  }

  // Brand-new venue aliases always use the clean format.
  if ($operation === 'insert') {
    $alias = $clean_alias;
    return;
  }

  $source = (string) ($context['source'] ?? '');
  $language = (string) ($context['language'] ?? '');

  if ($source === '' || $language === '') {
    return;
  }

  // Use an exact source + language lookup. Do not use the path alias manager
  // here because language fallback can make a newly created translation appear
  // to have an existing alias when only another language has one.
  $existing_alias = _spotdeals_data_ingestion_load_exact_alias(
    $source,
    $language,
  );

  // No alias exists for this exact language yet. This commonly happens when a
  // Spanish translation is created after the English node, where Pathauto uses
  // the "update" operation. Treat it as a new language alias.
  if ($existing_alias === NULL) {
    $alias = $clean_alias;
    return;
  }

  // Preserve clean-style aliases during later update/bulkupdate operations.
  // Existing old-style aliases are intentionally left untouched.
  if (
    $existing_alias === $clean_alias
    || preg_match(
      '/^' . preg_quote($clean_alias, '/') . '-\d+$/',
      $existing_alias,
    ) === 1
  ) {
    $alias = $clean_alias;
  }
}

/**
 * Loads an alias only when it exists for the exact source and language.
 */
function _spotdeals_data_ingestion_load_exact_alias(
  string $source,
  string $language,
): ?string {
  try {
    $storage = \Drupal::entityTypeManager()->getStorage('path_alias');

    $ids = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('path', $source)
      ->condition('langcode', $language)
      ->sort('id', 'DESC')
      ->range(0, 1)
      ->execute();

    if ($ids === []) {
      return NULL;
    }

    $alias_entity = $storage->load(reset($ids));

    if ($alias_entity === NULL) {
      return NULL;
    }

    return (string) $alias_entity->getAlias();
  }
  catch (\Throwable) {
    return NULL;
  }
}

/**
 * Builds the clean candidate for a venue alias.
 *
 * The configured venue Pathauto pattern is:
 *
 *   /venue/[node:field_address:locality]/[node:title]
 *
 * This helper removes exactly one trailing copy of the city path segment from
 * the title slug. It does not alter the node title and does not remove city
 * names appearing elsewhere in the venue name.
 */
function _spotdeals_data_ingestion_clean_venue_alias_candidate(
  string $alias,
): ?string {
  $segments = explode('/', trim($alias, '/'));

  if (
    count($segments) !== 3
    || $segments[0] !== 'venue'
    || $segments[1] === ''
    || $segments[2] === ''
  ) {
    return NULL;
  }

  $city_slug = $segments[1];
  $venue_slug = $segments[2];
  $city_suffix = '-' . $city_slug;

  if (!str_ends_with($venue_slug, $city_suffix)) {
    return NULL;
  }

  $clean_venue_slug = substr(
    $venue_slug,
    0,
    strlen($venue_slug) - strlen($city_suffix),
  );

  if ($clean_venue_slug === '') {
    return NULL;
  }

  $segments[2] = $clean_venue_slug;

  return '/' . implode('/', $segments);
}

/**
 * Implements hook_cron().
 *
 * Refreshes the provider category catalog when stale and keeps safe automatic
 * venue-type mappings synchronized. Failures are logged and do not interrupt
 * the rest of cron.
 */
function spotdeals_data_ingestion_cron(): void {
  try {
    \Drupal::service('spotdeals_data_ingestion.venue_type_mapping_manager')
      ->syncAll(FALSE);
  }
  catch (\Throwable $exception) {
    \Drupal::logger('spotdeals_data_ingestion')->warning(
      'Automatic Geoapify venue-type mapping sync failed during cron: {message}',
      ['message' => $exception->getMessage()],
    );
  }

  try {
    $result = \Drupal::service('spotdeals_data_ingestion.deal_discovery_auto_publisher')
      ->processCronBatch();

    if (
      (int) ($result['processed'] ?? 0) > 0
      || (int) ($result['readiness_rechecked'] ?? 0) > 0
      || (int) ($result['historical_scanned'] ?? 0) > 0
    ) {
      \Drupal::logger('spotdeals_data_ingestion')->notice(
        'Deal-discovery cron rechecked {rechecked} stale readiness candidate(s): {restored} restored, {still_blocked} still blocked; historical pending scan inspected {historical_scanned}: {historical_eligible} classifier-eligible, {historical_restored} restored, {historical_duplicates} duplicate(s) rejected, {historical_blocked} publishing-blocked, {historical_location} location-safety skip(s), {historical_reviewed} reviewed skip(s), {historical_errors} error(s); publishing processed {processed}: {published} published, {already} already published, {duplicates} total duplicate(s) rejected, {review} routed to review, {failed} left queued for retry.',
        [
          'rechecked' => (int) ($result['readiness_rechecked'] ?? 0),
          'restored' => (int) ($result['readiness_restored'] ?? 0),
          'still_blocked' => (int) ($result['readiness_still_blocked'] ?? 0),
          'historical_scanned' => (int) ($result['historical_scanned'] ?? 0),
          'historical_eligible' => (int) ($result['historical_classifier_eligible'] ?? 0),
          'historical_restored' => (int) ($result['historical_restored'] ?? 0),
          'historical_duplicates' => (int) ($result['historical_duplicates'] ?? 0),
          'historical_blocked' => (int) ($result['historical_blocked'] ?? 0),
          'historical_location' => (int) ($result['historical_skipped_location'] ?? 0),
          'historical_reviewed' => (int) ($result['historical_skipped_reviewed'] ?? 0),
          'historical_errors' => (int) ($result['historical_errors'] ?? 0),
          'processed' => (int) ($result['processed'] ?? 0),
          'published' => (int) ($result['published'] ?? 0),
          'already' => (int) ($result['already_published'] ?? 0),
          'duplicates' => (int) ($result['duplicate_rejected'] ?? 0),
          'review' => (int) ($result['routed_to_review'] ?? 0),
          'failed' => (int) ($result['failed'] ?? 0),
        ],
      );
    }
  }
  catch (\Throwable $exception) {
    \Drupal::logger('spotdeals_data_ingestion')->warning(
      'Deal-discovery automatic publishing cron failed safely: {message}',
      ['message' => $exception->getMessage()],
    );
  }

  try {
    \Drupal::service('spotdeals_data_ingestion.deal_discovery_daily_digest')
      ->sendCompletedDigests();
  }
  catch (\Throwable $exception) {
    \Drupal::logger('spotdeals_data_ingestion')->warning(
      'Deal-discovery daily publishing digest failed safely during cron: {message}',
      ['message' => $exception->getMessage()],
    );
  }
}

/**
 * Implements hook_mail().
 */
function spotdeals_data_ingestion_mail(
  string $key,
  array &$message,
  array $params,
): void {
  if ($key !== 'deal_discovery_daily_digest') {
    return;
  }

  $message['subject'] = (string) ($params['subject'] ?? 'SpotDeals daily publishing summary');
  $message['body'][] = (string) ($params['body'] ?? '');
}

/**
 * Implements hook_taxonomy_term_insert().
 */
function spotdeals_data_ingestion_taxonomy_term_insert(TermInterface $term): void {
  _spotdeals_data_ingestion_sync_venue_type_term($term);
}

/**
 * Implements hook_taxonomy_term_update().
 */
function spotdeals_data_ingestion_taxonomy_term_update(TermInterface $term): void {
  _spotdeals_data_ingestion_sync_venue_type_term($term);
}

/**
 * Synchronizes one venue-type term when a cached provider catalog is present.
 */
function _spotdeals_data_ingestion_sync_venue_type_term(TermInterface $term): void {
  static $syncing = FALSE;

  if ($syncing) {
    return;
  }

  try {
    $resolver = \Drupal::service('spotdeals_data_ingestion.venue_type_resolver');
    if ($term->bundle() !== $resolver->venueTypeVocabularyId()) {
      return;
    }

    $syncing = TRUE;
    \Drupal::service('spotdeals_data_ingestion.venue_type_mapping_manager')
      ->syncTerm($term);
  }
  catch (\Throwable $exception) {
    \Drupal::logger('spotdeals_data_ingestion')->warning(
      'Unable to synchronize automatic Geoapify mapping for venue type "{venue_type}": {message}',
      [
        'venue_type' => $term->label(),
        'message' => $exception->getMessage(),
      ],
    );
  }
  finally {
    $syncing = FALSE;
  }
}

/**
 * Implements hook_form_taxonomy_term_form_alter().
 *
 * Shows the current automatically managed mapping while keeping that field
 * out of the editable form. Manual overrides remain available only when the
 * automatic mapping needs correction.
 */
function spotdeals_data_ingestion_form_taxonomy_term_form_alter(
  array &$form,
  FormStateInterface $form_state,
): void {
  $term = $form_state->getFormObject()->getEntity();
  if (!$term instanceof TermInterface) {
    return;
  }

  try {
    $resolver = \Drupal::service('spotdeals_data_ingestion.venue_type_resolver');
    if ($term->bundle() !== $resolver->venueTypeVocabularyId()) {
      return;
    }
  }
  catch (\Throwable) {
    return;
  }

  $automatic = [];
  if (
    $term->hasField('field_geoapify_auto_categories')
    && !$term->get('field_geoapify_auto_categories')->isEmpty()
  ) {
    foreach ($term->get('field_geoapify_auto_categories') as $item) {
      $value = trim((string) $item->value);
      if ($value !== '') {
        $automatic[] = $value;
      }
    }
  }

  $form['spotdeals_geoapify_automatic_mapping'] = [
    '#type' => 'details',
    '#title' => t('Geoapify automatic mapping'),
    '#open' => TRUE,
    '#weight' => 19,
  ];

  if ($automatic === []) {
    $form['spotdeals_geoapify_automatic_mapping']['status'] = [
      '#markup' => '<p>' . t('No high-confidence automatic mapping is currently stored for this venue type. Run the Geoapify mapping sync/audit commands to refresh provider mappings. Use the override field below only when an automatic mapping cannot be resolved safely.') . '</p>',
    ];
    return;
  }

  $form['spotdeals_geoapify_automatic_mapping']['intro'] = [
    '#markup' => '<p>' . t('Automatically managed from the current Geoapify category catalog. The override field below should normally remain empty.') . '</p>',
  ];
  $form['spotdeals_geoapify_automatic_mapping']['categories'] = [
    '#theme' => 'item_list',
    '#items' => $automatic,
  ];
}
