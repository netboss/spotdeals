/**
 * Creates external venue report storage and CAPTCHA protection.
 */
function spotdeals_data_ingestion_update_10001(): void {
  $schema = \Drupal::database()->schema();
  foreach (spotdeals_data_ingestion_schema() as $table => $definition) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $definition);
    }
  }

  if (\Drupal::moduleHandler()->moduleExists('captcha')) {
    \Drupal::configFactory()->getEditable('captcha.captcha_point.spotdeals_external_venue_report_form')
      ->set('formId', 'spotdeals_external_venue_report_form')
      ->set('captchaType', 'default')
      ->set('label', 'spotdeals_external_venue_report_form')
      ->set('status', TRUE)
      ->save();
  }

  _spotdeals_data_ingestion_grant_report_permission();
}

/**
 * Implements hook_install().
 */
function spotdeals_data_ingestion_install(): void {
  _spotdeals_data_ingestion_grant_report_permission();
  _spotdeals_data_ingestion_ensure_venue_type_metadata_fields();
}

/**
 * Grants public report submission to anonymous and authenticated users.
 */
function _spotdeals_data_ingestion_grant_report_permission(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('user_role');
  foreach (['anonymous', 'authenticated'] as $role_id) {
    $role = $storage->load($role_id);
    if ($role && !$role->hasPermission('submit external venue reports')) {
      $role->grantPermission('submit external venue reports');
      $role->save();
    }
  }
}


/**
 * Adds taxonomy-owned Geoapify mappings and search aliases to venue types.
 */
function spotdeals_data_ingestion_update_10002(): void {
  _spotdeals_data_ingestion_ensure_venue_type_metadata_fields();
}

/**
 * Adds automatically managed Geoapify venue-type mappings.
 */
function spotdeals_data_ingestion_update_10003(): void {
  _spotdeals_data_ingestion_ensure_venue_type_metadata_fields();

  $config = \Drupal::configFactory()->getEditable('spotdeals_data_ingestion.settings');
  $defaults = [
    'category_catalog_url' => 'https://apidocs.geoapify.com/docs/places/',
    'category_catalog_max_age' => 604800,
    'category_catalog_minimum_size' => 100,
    'mapping_min_score' => 0.90,
    'mapping_ambiguity_delta' => 0.05,
  ];

  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
    }
  }

  $config->save();
}



/**
 * Creates persistent storage for administrative deal-discovery review.
 */
function spotdeals_data_ingestion_update_10004(): void {
  $schema = \Drupal::database()->schema();
  $definitions = spotdeals_data_ingestion_schema();
  $table = 'spotdeals_deal_discovery_candidate';

  if (!$schema->tableExists($table)) {
    $schema->createTable($table, $definitions[$table]);
  }
}




/**
 * Adds confidence classification metadata to deal-discovery candidates.
 */
function spotdeals_data_ingestion_update_10005(): void {
  $schema = \Drupal::database()->schema();
  $table = 'spotdeals_deal_discovery_candidate';

  if (!$schema->fieldExists($table, 'confidence')) {
    $schema->addField($table, 'confidence', [
      'type' => 'varchar',
      'length' => 32,
      'not null' => TRUE,
      'default' => 'review',
    ]);
  }

  if (!$schema->fieldExists($table, 'classification_reason')) {
    $schema->addField($table, 'classification_reason', [
      'type' => 'text',
      'size' => 'normal',
      'not null' => FALSE,
    ]);
  }
}


/**
 * Initializes deal-discovery automation settings on existing installations.
 */
function spotdeals_data_ingestion_update_10006(): void {
  $modulePath = \Drupal::service('extension.list.module')
    ->getPath('spotdeals_data_ingestion');
  $installConfigPath = $modulePath . '/config/install/spotdeals_data_ingestion.settings.yml';

  if (!is_file($installConfigPath) || !is_readable($installConfigPath)) {
    throw new \RuntimeException(
      'Unable to read the SpotDeals data-ingestion install configuration.',
    );
  }

  $defaults = \Drupal\Component\Serialization\Yaml::decode(
    (string) file_get_contents($installConfigPath),
  );
  if (!is_array($defaults)) {
    throw new \RuntimeException(
      'The SpotDeals data-ingestion install configuration is invalid.',
    );
  }

  $keys = [
    'deal_discovery_auto_approve_score',
    'deal_discovery_auto_approve_location_confidence',
    'deal_discovery_auto_approve_require_schedule',
  ];

  $config = \Drupal::configFactory()
    ->getEditable('spotdeals_data_ingestion.settings');

  foreach ($keys as $key) {
    if ($config->get($key) !== NULL) {
      continue;
    }

    if (!array_key_exists($key, $defaults)) {
      throw new \RuntimeException(
        sprintf('Missing required install configuration key "%s".', $key),
      );
    }

    $config->set($key, $defaults[$key]);
  }

  $config->save();
}


