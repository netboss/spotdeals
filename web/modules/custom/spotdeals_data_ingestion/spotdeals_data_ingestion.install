<?php

declare(strict_types=1);

/**
 * Implements hook_schema().
 */
function spotdeals_data_ingestion_schema(): array {
  $schema['spotdeals_external_venue_report'] = [
    'description' => 'User reports about external venue listings.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'external_source' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE],
      'external_id' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'venue_name' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'venue_address' => ['type' => 'text', 'size' => 'normal', 'not null' => FALSE],
      'reason' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'details' => ['type' => 'text', 'size' => 'normal', 'not null' => FALSE],
      'email' => ['type' => 'varchar', 'length' => 254, 'not null' => FALSE],
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'ip_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'status' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'pending'],
      'admin_notes' => ['type' => 'text', 'size' => 'normal', 'not null' => FALSE],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'reviewed_by' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'reviewed_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'external_venue' => ['external_source', 'external_id'],
      'status_created' => ['status', 'created'],
      'reporter' => ['uid', 'created'],
      'ip_created' => ['ip_hash', 'created'],
    ],
  ];

  $schema['spotdeals_external_venue_exclusion'] = [
    'description' => 'External venue listings excluded from hybrid search.',
    'fields' => [
      'external_source' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE],
      'external_id' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'venue_name' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'venue_address' => ['type' => 'text', 'size' => 'normal', 'not null' => FALSE],
      'reason' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'active' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 1],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'created_by' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['external_source', 'external_id'],
    'indexes' => [
      'active' => ['active'],
    ],
  ];

  return $schema;
}

/**
 * Creates external venue report storage and CAPTCHA protection.
 */
function spotdeals_data_ingestion_update_10001(): void {
  $schema = \Drupal::database()->schema();
  foreach (spotdeals_data_ingestion_schema() as $table => $definition) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $definition);
    }
  }

  if (\Drupal::moduleHandler()->moduleExists('captcha')) {
    \Drupal::configFactory()->getEditable('captcha.captcha_point.spotdeals_external_venue_report_form')
      ->set('formId', 'spotdeals_external_venue_report_form')
      ->set('captchaType', 'default')
      ->set('label', 'spotdeals_external_venue_report_form')
      ->set('status', TRUE)
      ->save();
  }

  _spotdeals_data_ingestion_grant_report_permission();
}

/**
 * Implements hook_install().
 */
function spotdeals_data_ingestion_install(): void {
  _spotdeals_data_ingestion_grant_report_permission();
  _spotdeals_data_ingestion_ensure_venue_type_metadata_fields();
}

/**
 * Grants public report submission to anonymous and authenticated users.
 */
function _spotdeals_data_ingestion_grant_report_permission(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('user_role');
  foreach (['anonymous', 'authenticated'] as $role_id) {
    $role = $storage->load($role_id);
    if ($role && !$role->hasPermission('submit external venue reports')) {
      $role->grantPermission('submit external venue reports');
      $role->save();
    }
  }
}


/**
 * Adds taxonomy-owned Geoapify mappings and search aliases to venue types.
 */
function spotdeals_data_ingestion_update_10002(): void {
  _spotdeals_data_ingestion_ensure_venue_type_metadata_fields();
}

/**
 * Adds automatically managed Geoapify venue-type mappings.
 */
function spotdeals_data_ingestion_update_10003(): void {
  _spotdeals_data_ingestion_ensure_venue_type_metadata_fields();

  $config = \Drupal::configFactory()->getEditable('spotdeals_data_ingestion.settings');
  $defaults = [
    'category_catalog_url' => 'https://apidocs.geoapify.com/docs/places/',
    'category_catalog_max_age' => 604800,
    'category_catalog_minimum_size' => 100,
    'mapping_min_score' => 0.90,
    'mapping_ambiguity_delta' => 0.05,
  ];

  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
    }
  }

  $config->save();
}

/**
 * Ensures provider metadata fields exist on the venue-type vocabulary.
 */
function _spotdeals_data_ingestion_ensure_venue_type_metadata_fields(): void {
  $entityFieldManager = \Drupal::service('entity_field.manager');
  $definitions = $entityFieldManager->getFieldDefinitions('node', 'venue');
  $venueTypeField = $definitions['field_venue_type'] ?? NULL;
  if ($venueTypeField === NULL) {
    throw new \RuntimeException('The venue content type does not expose field_venue_type.');
  }

  $settings = $venueTypeField->getSettings();
  $handlerSettings = is_array($settings['handler_settings'] ?? NULL)
    ? $settings['handler_settings']
    : [];
  $targetBundles = is_array($handlerSettings['target_bundles'] ?? NULL)
    ? array_filter($handlerSettings['target_bundles'])
    : [];
  $vocabularyId = $targetBundles !== [] ? (string) array_key_first($targetBundles) : '';

  if ($vocabularyId === '') {
    throw new \RuntimeException('Unable to determine the vocabulary used by field_venue_type.');
  }

  $storageConfigStorage = \Drupal::entityTypeManager()->getStorage('field_storage_config');
  $fieldConfigStorage = \Drupal::entityTypeManager()->getStorage('field_config');

  $fields = [
    'field_geoapify_categories' => [
      'label' => 'Geoapify category overrides',
      'description' => 'Optional manual overrides, one Geoapify Places API category per value. Leave empty to use the automatically managed mapping.',
    ],
    'field_geoapify_auto_categories' => [
      'label' => 'Geoapify automatic categories',
      'description' => 'Automatically managed provider categories. These values are synchronized from the current Geoapify category catalog and are not intended for manual editing.',
    ],
    'field_search_aliases' => [
      'label' => 'Search aliases',
      'description' => 'Optional additional search phrases that should resolve to this venue type, one alias per value. The venue-type label is always matched automatically.',
    ],
  ];

  foreach ($fields as $fieldName => $fieldInfo) {
    $storageId = 'taxonomy_term.' . $fieldName;
    $fieldStorage = $storageConfigStorage->load($storageId);
    if ($fieldStorage === NULL) {
      $fieldStorage = $storageConfigStorage->create([
        'field_name' => $fieldName,
        'entity_type' => 'taxonomy_term',
        'type' => 'string',
        'cardinality' => -1,
        'settings' => [
          'max_length' => 255,
          'is_ascii' => FALSE,
          'case_sensitive' => FALSE,
        ],
      ]);
      $fieldStorage->save();
    }

    $fieldId = 'taxonomy_term.' . $vocabularyId . '.' . $fieldName;
    $fieldConfig = $fieldConfigStorage->load($fieldId);
    if ($fieldConfig === NULL) {
      $fieldConfig = $fieldConfigStorage->create([
        'field_storage' => $fieldStorage,
        'bundle' => $vocabularyId,
        'label' => $fieldInfo['label'],
        'description' => $fieldInfo['description'],
        'required' => FALSE,
      ]);
    }
    else {
      $fieldConfig
        ->set('label', $fieldInfo['label'])
        ->set('description', $fieldInfo['description']);
    }
    $fieldConfig->save();
  }

  $formDisplayStorage = \Drupal::entityTypeManager()->getStorage('entity_form_display');
  $formDisplayId = 'taxonomy_term.' . $vocabularyId . '.default';
  $formDisplay = $formDisplayStorage->load($formDisplayId);
  if ($formDisplay === NULL) {
    $formDisplay = $formDisplayStorage->create([
      'targetEntityType' => 'taxonomy_term',
      'bundle' => $vocabularyId,
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }

  $formDisplay->setComponent('field_geoapify_categories', [
    'type' => 'string_textfield',
    'weight' => 20,
    'settings' => [
      'size' => 60,
      'placeholder' => '',
    ],
  ]);
  $formDisplay->setComponent('field_search_aliases', [
    'type' => 'string_textfield',
    'weight' => 21,
    'settings' => [
      'size' => 60,
      'placeholder' => '',
    ],
  ]);
  $formDisplay->removeComponent('field_geoapify_auto_categories');
  $formDisplay->save();
}
