<?php

declare(strict_types=1);

use Drupal\Core\Database\Database;
use Drupal\views\ViewExecutable;
use Drupal\node\NodeInterface;

use Drupal\taxonomy\TermInterface;

/**
 * Implements hook_preprocess_taxonomy_term().
 */
function spotdeals_seo_landing_preprocess_taxonomy_term(array &$variables): void {
  $term = $variables['term'] ?? NULL;
  if (!$term instanceof TermInterface) {
    return;
  }

  $landing_vocabularies = [
    'day_of_week',
    'deal_category',
    'cuisine',
    'venue_type',
    'neighborhood',
    'tags',
  ];
  if (!in_array($term->bundle(), $landing_vocabularies, TRUE)) {
    return;
  }

  $variables['spotdeals_taxonomy_backend'] = \Drupal::service('spotdeals_seo_landing.taxonomy_landing_data')->build($term);
}

/**
 * Implements hook_views_pre_execute().
 */
function spotdeals_seo_landing_views_pre_execute(ViewExecutable $view): void {
  if ($view->id() !== 'venue_info') {
    return;
  }

  if ((string) $view->current_display !== 'block_2') {
    return;
  }

  $request_path = \Drupal::request()->getPathInfo();
  if (!is_string($request_path) || strpos($request_path, '/deals/') !== 0) {
    return;
  }

  $segments = array_values(array_filter(explode('/', trim($request_path, '/'))));
  if (count($segments) < 2 || $segments[0] !== 'deals') {
    return;
  }

  $city_slug = trim((string) $segments[1]);
  if ($city_slug === '') {
    return;
  }

  $city_label = _spotdeals_seo_landing_resolve_city_label($city_slug);
  if ($city_label === NULL) {
    return;
  }

  $view->args[0] = $city_label;
}

/**
 * Implements hook_views_post_execute().
 *
 * SD-219 resolves the relevant Blog guide in the backend module layer. Theme
 * code only consumes the prepared guide data and never performs entity/DB
 * lookups.
 */
function spotdeals_seo_landing_views_post_execute(ViewExecutable $view): void {
  if ($view->id() !== 'deals_search_solr' || (string) $view->current_display !== 'page_1') {
    return;
  }

  if (!\Drupal::hasService('spotdeals_seo_landing.blog_search_matcher')) {
    return;
  }

  $request = \Drupal::request();
  $locality = trim((string) $request->attributes->get('spotdeals_search_smart_location.city', ''));

  if ($locality === '') {
    $locality = trim((string) $request->query->get('locality_exact', ''));
  }

  if ($locality === '') {
    return;
  }

  $search_text = trim((string) $request->attributes->get(
    'spotdeals_search_smart_location.raw_query',
    (string) $request->query->get('search_raw', '')
  ));

  $guides = \Drupal::service('spotdeals_seo_landing.blog_search_matcher')
    ->findForSearch($locality, $search_text, 1);

  if ($guides === []) {
    return;
  }

  $guide = reset($guides);
  $view->build_info['spotdeals_search_guide'] = [
    'title' => (string) ($guide['title'] ?? ''),
    'url' => (string) ($guide['url'] ?? ''),
    'summary' => (string) ($guide['summary'] ?? ''),
  ];
}


/**
 * Implements hook_preprocess_views_view().
 *
 * Recommendation/Near Me locality is finalized by the smart-location module
 * during Views preprocessing, which is later than views_post_execute(). Resolve
 * the guide here as a backend fallback so the theme never performs entity/DB
 * lookups.
 */
function spotdeals_seo_landing_preprocess_views_view(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view instanceof ViewExecutable || $view->id() !== 'deals_search_solr' || (string) $view->current_display !== 'page_1') {
    return;
  }

  $guide = $view->build_info['spotdeals_search_guide'] ?? NULL;

  if (!is_array($guide) || empty($guide['title']) || empty($guide['url'])) {
    if (!\Drupal::hasService('spotdeals_seo_landing.blog_search_matcher')) {
      return;
    }

    $request = \Drupal::request();
    $locality = trim((string) $request->attributes->get('spotdeals_search_smart_location.city', ''));
    if ($locality === '') {
      $locality = trim((string) $request->query->get('locality_exact', ''));
    }
    if ($locality === '') {
      return;
    }

    $search_text = trim((string) $request->attributes->get(
      'spotdeals_search_smart_location.raw_query',
      (string) $request->query->get('search_raw', '')
    ));

    $guides = \Drupal::service('spotdeals_seo_landing.blog_search_matcher')
      ->findForSearch($locality, $search_text, 1);
    if ($guides === []) {
      return;
    }

    $matched = reset($guides);
    $guide = [
      'title' => (string) ($matched['title'] ?? ''),
      'url' => (string) ($matched['url'] ?? ''),
      'summary' => (string) ($matched['summary'] ?? ''),
    ];
    $view->build_info['spotdeals_search_guide'] = $guide;
  }

  $variables['spotdeals_search_guide'] = $guide;
}

/**
 * Resolves a city slug like "port-orange" to the stored locality label.
 */
function _spotdeals_seo_landing_resolve_city_label(string $city_slug): ?string {
  static $resolved = [];

  $normalized_target = _spotdeals_seo_landing_normalize_for_comparison($city_slug);
  if (array_key_exists($normalized_target, $resolved)) {
    return $resolved[$normalized_target];
  }

  $candidate = _spotdeals_seo_landing_slug_to_likely_label($city_slug);

  $query = Database::getConnection()->select('node__field_address', 'fa');
  $query->addField('fa', 'field_address_locality');
  $query->isNotNull('fa.field_address_locality');
  $query->condition('fa.field_address_locality', '', '<>');
  $query->condition('fa.field_address_locality', $candidate);
  $query->range(0, 1);

  $exact = $query->execute()->fetchField();
  if (is_string($exact) && trim($exact) !== '') {
    $resolved[$normalized_target] = trim($exact);
    return $resolved[$normalized_target];
  }

  $query = Database::getConnection()->select('node__field_address', 'fa');
  $query->addField('fa', 'field_address_locality');
  $query->isNotNull('fa.field_address_locality');
  $query->condition('fa.field_address_locality', '', '<>');
  $query->distinct();
  $query->orderBy('fa.field_address_locality', 'ASC');

  foreach ($query->execute()->fetchCol() as $locality) {
    if (!is_string($locality)) {
      continue;
    }

    if (_spotdeals_seo_landing_normalize_for_comparison($locality) === $normalized_target) {
      $resolved[$normalized_target] = trim($locality);
      return $resolved[$normalized_target];
    }
  }

  $resolved[$normalized_target] = NULL;
  return NULL;
}

/**
 * Converts a slug to a likely stored label.
 */
function _spotdeals_seo_landing_slug_to_likely_label(string $slug): string {
  $label = str_replace(['-', '_'], ' ', trim($slug));
  $label = preg_replace('/\s+/u', ' ', $label) ?? $label;

  return mb_convert_case(trim($label), MB_CASE_TITLE, 'UTF-8');
}

/**
 * Normalizes a slug or label for reliable comparison.
 */
function _spotdeals_seo_landing_normalize_for_comparison(string $value): string {
  $value = trim($value);
  $value = mb_strtolower($value, 'UTF-8');
  $value = str_replace(['-', '_'], ' ', $value);
  $value = preg_replace('/[^[:alnum:]\s]+/u', ' ', $value) ?? '';
  $value = preg_replace('/\s+/u', ' ', $value) ?? '';

  return trim($value);
}


/**
 * Implements hook_preprocess_page().
 */
function spotdeals_seo_landing_preprocess_page(array &$variables): void {
  $node = \Drupal::routeMatch()->getParameter('node');
  if (!$node instanceof NodeInterface || $node->bundle() !== 'deal') {
    return;
  }

  if (!$node->hasField('field_venue') || $node->get('field_venue')->isEmpty()) {
    return;
  }

  $venue = $node->get('field_venue')->entity;
  if (!$venue instanceof NodeInterface) {
    return;
  }

  $variables['spotdeals_deal_related_deals'] = \Drupal::service('spotdeals_seo_landing.deal_page_data')
    ->buildRelatedDeals($node, $venue);
}

/**
 * Implements hook_metatags_alter().
 *
 * SD-230: Provide descriptions for deals and venues without requiring a body
 * field or editorial updates to existing content. Leave all other tags alone.
 */
function spotdeals_seo_landing_metatags_alter(array &$metatags, array &$context): void {
  $node = $context['entity'] ?? $context['token_data']['node'] ?? NULL;
  if (!$node instanceof NodeInterface || !in_array($node->bundle(), ['deal', 'venue'], TRUE)) {
    return;
  }

  // Metatag may run for non-canonical entity contexts (e.g. previews).
  if (!$node->isPublished()) {
    return;
  }

  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
  if ($node->hasTranslation($langcode)) {
    $node = $node->getTranslation($langcode);
  }
  $spanish = $langcode === 'es';

  // A translated node can still expose an untranslated field value. Do not
  // present English offer copy or venue summaries as Spanish metadata.
  $localized_text = static function (NodeInterface $entity, string $field_name, string $langcode): string {
    if (!$entity->hasField($field_name) || $entity->get($field_name)->isEmpty()) {
      return '';
    }
    $field = $entity->get($field_name);
    if ($langcode === 'es') {
      if (!$entity->hasTranslation('es') || !$field->getFieldDefinition()->isTranslatable()) {
        return '';
      }
      $original = $entity->getUntranslated();
      if ($original->hasField($field_name) && !$original->get($field_name)->isEmpty()
        && $field->getValue() === $original->get($field_name)->getValue()) {
        return '';
      }
    }
    $item = $field->first();
    $value = trim(strip_tags((string) ($item->summary ?? '')));
    return $value !== '' ? $value : trim(strip_tags((string) ($item->value ?? '')));
  };
  $title = trim($node->label());
  if ($title === '') {
    return;
  }

  $place = static function (NodeInterface $entity): string {
    if (!$entity->hasField('field_address') || $entity->get('field_address')->isEmpty()) {
      return '';
    }
    $address = $entity->get('field_address')->first();
    $parts = array_filter([
      trim((string) ($address->locality ?? '')),
      trim((string) ($address->administrative_area ?? '')),
    ]);
    return implode(', ', $parts);
  };

  // Avoid repeating a location already present in the node/venue title.
  $append_location = static function (string $name, string $location, bool $spanish): string {
    if ($location === '') {
      return '';
    }
    $city = trim(explode(',', $location, 2)[0]);
    if ($city !== '' && mb_stripos($name, $city, 0, 'UTF-8') !== FALSE) {
      return '';
    }
    return ($spanish ? ' en ' : ' in ') . $location;
  };

  if ($node->bundle() === 'deal') {
    $venue = NULL;
    if ($node->hasField('field_venue') && !$node->get('field_venue')->isEmpty()) {
      $venue = $node->get('field_venue')->entity;
    }
    $venue_name = $venue instanceof NodeInterface ? trim($venue->label()) : '';
    $location = $venue instanceof NodeInterface ? $place($venue) : '';
    // Do not append free-form English offer copy to Spanish search snippets.
    // Field translation presence alone does not establish translated content.
    $offer = $spanish ? '' : $localized_text($node, 'field_price_offer_text', $langcode);

    $description = $spanish ? 'Descubre ' . $title : 'Explore ' . $title;
    if ($venue_name !== '') {
      $description .= ($spanish ? ' en ' : ' at ') . $venue_name;
    }
    $description .= $append_location($venue_name !== '' ? $venue_name : $title, $location, $spanish);
    $description .= '.';
    if ($offer !== '') {
      $description .= ' ' . $offer . '.';
    }
    else {
      $description .= $spanish ? ' Consulta los detalles de la oferta.' : ' See offer details.';
    }
  }
  else {
    $location = $place($node);
    $summary = '';
    foreach (['field_short_description', 'body'] as $field_name) {
      $summary = $localized_text($node, $field_name, $langcode);
      if ($summary !== '') {
        break;
      }
    }
    $description = $spanish ? 'Descubre ofertas en ' . $title : 'Discover deals at ' . $title;
    $description .= $append_location($title, $location, $spanish);
    $description .= '.';
    if ($summary !== '') {
      $description .= ' ' . $summary;
    }
    else {
      $description .= $spanish ? ' Consulta las ofertas y los detalles del establecimiento.' : ' Explore available offers and venue details.';
    }
  }

  $description = trim(preg_replace('/\s+/u', ' ', $description) ?? $description);
  if (mb_strlen($description) > 160) {
    $description = rtrim(mb_substr($description, 0, 157), " ,.;:") . '…';
  }
  $metatags['description'] = $description;
}
