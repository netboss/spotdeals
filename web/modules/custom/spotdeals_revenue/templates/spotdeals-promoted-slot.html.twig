{#
/**
 * @file
 * Controlled promoted slot for SpotDeals revenue providers.
 */
#}
<div class="spotdeals-promoted-slot" role="complementary" aria-label="{{ label }}">
  <div class="spotdeals-promoted-slot__label">{{ label }}</div>
  <div class="spotdeals-promoted-slot__content">
    {% if adsense_client and adsense_slot %}
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="{{ adsense_client }}"
           data-ad-slot="{{ adsense_slot }}"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
    {% else %}
      {{ markup|raw }}
    {% endif %}
  </div>
</div>
