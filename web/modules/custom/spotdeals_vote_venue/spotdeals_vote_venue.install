        'unsigned' => TRUE,
      ],
      'changed' => [
        'description' => 'Changed timestamp.',
        'type' => 'int',
        'not null' => TRUE,
        'unsigned' => TRUE,
      ],
      'source' => [
        'description' => 'Optional source label such as venue_page.',
        'type' => 'varchar',
        'length' => 32,
        'not null' => FALSE,
      ],
      'vote_schema_version' => [
        'description' => 'Schema version of the vote row.',
